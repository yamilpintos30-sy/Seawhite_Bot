# ==============================================================================
# Bot de WhatsApp SEA WHITE — configuración
# Copiá este archivo a ".env" y completá los valores. NUNCA subas el .env a git.
# ==============================================================================

# --- Identidad --------------------------------------------------------------
BOT_NAME=Enri                        # nombre del asistente (saludo + personalidad IA)

# --- Servidor ---------------------------------------------------------------
PORT=3000
LOG_LEVEL=info                       # trace | debug | info | warn | error
TIMEZONE=America/Argentina/Buenos_Aires

# --- Chatwoot ---------------------------------------------------------------
# Chatwoot Cloud: https://app.chatwoot.com  (si es self-hosted, poné tu URL)
CHATWOOT_BASE_URL=https://app.chatwoot.com
# Perfil > Configuración de perfil > Token de acceso (o el token del Agent Bot)
CHATWOOT_API_TOKEN=
# Número que aparece en la URL de Chatwoot: /app/accounts/<ID>/...
CHATWOOT_ACCOUNT_ID=
# Los webhooks de Chatwoot son A NIVEL CUENTA. Si la cuenta tiene varios
# inboxes u otros bots, poné acá el inbox_id de ESTE bot (se ve en la URL:
# .../settings/inboxes/<NUMERO>) para ignorar el resto. Vacío = sin filtro.
CHATWOOT_INBOX_ID=
# Token inventado por vos; se agrega a la URL del webhook: ?token=<WEBHOOK_SECRET>
WEBHOOK_SECRET=cambiame-por-algo-largo-y-secreto
# Estados de conversación en los que el bot responde
BOT_ACTIVE_STATUSES=pending,open
# ¿El usuario puede pedir hablar con una persona? false = 100% automático
# (ante "quiero hablar con alguien" el bot explica que la atención es automática).
# Si un agente humano escribe desde Chatwoot, el bot se calla igual con cualquier valor.
HANDOFF_ENABLED=false
# Estado al que pasa la conversación al derivar a una persona:
# none = no tocar el estado (recomendado con webhook de cuenta + token de perfil)
# open/pending = cambiar el estado (útil sólo con la función Agent Bot)
HANDOFF_STATUS=none
# Minutos que el bot se queda en silencio después de derivar a una persona
HANDOFF_SILENCE_MINUTES=120

# --- Claude (Anthropic) -----------------------------------------------------
# https://platform.claude.com -> API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5         # alternativa más capaz y cara: claude-opus-5
CLAUDE_EFFORT=medium                 # low | medium | high
CLAUDE_MAX_TOKENS=1500
CLAUDE_CACHE_TTL=1h                  # 5m | 1h (caching de la base de conocimiento)
CLAUDE_FALLBACKS=true                # fallback automático de modelo ante un "refusal"

# --- Base de conocimiento ---------------------------------------------------
KNOWLEDGE_DIR=knowledge              # carpeta con los .md/.txt editables
KNOWLEDGE_RELOAD_SECONDS=30

# --- SeaLink (API de vencimientos) ------------------------------------------
SEALINK_BASE_URL=https://api.seawhite.com.ar:9443
SEALINK_EMAIL=
SEALINK_PASSWORD=
SEALINK_SERVIDOR=1                   # 1 = Bahía Blanca, 2 = Añelo (por ahora siempre 1)
SEALINK_TIMEOUT_MS=15000

# --- Supabase (opcional; si se omite, las sesiones viven en memoria) --------
# Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Límites diarios por conversación (anti-abuso; 0 = sin límite) ----------
DAILY_AI_LIMIT=30                    # respuestas con IA por chat por día
DAILY_LOOKUP_LIMIT=30                # consultas de vencimientos por chat por día
AI_MAX_INPUT_CHARS=2000              # se recorta el mensaje si es más largo

# --- Ritmo de conversación ---------------------------------------------------
DEBOUNCE_SECONDS=7                   # junta mensajes y responde 7 s después del último (0 = off)
FOLLOWUP_ASK_MINUTES=3               # "¿necesitás algo más?" (0 = off)
FOLLOWUP_BYE_MINUTES=6               # despedida y cierre (0 = off)
FOLLOWUP_RESET_MINUTES=9             # respaldo de reseteo (0 = off)

# --- Sesiones ---------------------------------------------------------------
SESSION_TTL_MINUTES=60               # inactividad tras la cual se vuelve al menú principal
HISTORY_MAX_TURNS=10                 # turnos de contexto que recuerda la IA
